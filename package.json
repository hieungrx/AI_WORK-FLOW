{
  "name": "ai-workflow-template",
  "version": "1.0.0",
  "description": "Multi-Account Antigravity + Dual-Mentor (ChatGPT & Gemini) RPIR Starter Template",
  "main": "index.js",
  "scripts": {
    "test": "node .agents/scripts/run_tests.mjs",
    "test:workflow": "node .agents/tests/review_policy.test.mjs",
    "test:hardening": "node --test .agents/tests/hardening.test.mjs",
    "test:all": "node .agents/scripts/run_all_tests.mjs",
    "doctor": "node .agents/scripts/doctor.mjs",
    "ask-mentor": "node .agents/scripts/ask_mentor.mjs",
    "ask-gemini": "node .agents/scripts/ask_mentor.mjs --provider gemini",
    "ask-both": "node .agents/scripts/ask_mentor.mjs --provider both",
    "ensure-project": "node .agents/scripts/ask_mentor.mjs --ensure-project",
    "init-workflow": "node .agents/scripts/init_project.mjs",
    "checkpoint": "node .agents/scripts/checkpoint.mjs",
    "telegram-setup": "node .agents/scripts/telegram_setup.mjs",
    "telegram-daemon": "node .agents/scripts/telegram_daemon.mjs",
    "telegram-watch": "node .agents/scripts/wakeup_watcher.mjs",
    "telegram-reply": "node .agents/scripts/send_reply.mjs",
    "await-decision": "node .agents/scripts/await_decision.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "playwright-core": "^1.65.0"
  }
}
